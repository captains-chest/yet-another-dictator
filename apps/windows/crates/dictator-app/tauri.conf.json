{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dictator",
  "mainBinaryName": "Dictator",
  "identifier": "com.captainduckay.dictator",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Captain Duckay",
    "copyright": "MIT License",
    "category": "Productivity",
    "shortDescription": "Offline dictation into any app",
    "licenseFile": "../../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../../model-manifest.txt": "model-manifest.txt",
      "../../../../CHANGELOG.md": "CHANGELOG.md",
      "../../../../LICENSE": "LICENSE",
      "../../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../../macos/Resources/ThirdParty/S1-mini-LICENSE": "ThirdParty/S1-mini-LICENSE",
      "../../../macos/Resources/ThirdParty/S1-mini-NOTICE": "ThirdParty/S1-mini-NOTICE",
      "../../../macos/Resources/ThirdParty/llama.cpp-LICENSE": "ThirdParty/llama.cpp-LICENSE"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Dictator"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBNUMzQkY0QUM2MThCOEMKUldTTWkyR3M5RHRjS2d6d1J1NnhFL3hmKy9BRTFBWVNaaW1sbWFNVU1RcWZ0UmJrMXpPVDZJSUcK",
      "endpoints": [
        "https://github.com/captains-chest/yet-another-dictator/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
